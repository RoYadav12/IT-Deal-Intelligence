# Only needed for run.sh / run.bat / run_pipeline.py (command-line use).
# In the Streamlit app you paste your keys into the sidebar instead.
# Copy this file to .env and fill in your real keys. .env is git-ignored.
#
# Serper is the only required key. Without an LLM key the pipeline uses
# built-in heuristic extraction (Serper-only mode).
SERPER_API_KEY=your-serper-key-here
# Optional — improves extraction quality:
# ANTHROPIC_API_KEY=your-anthropic-key-here
# To use OpenAI instead of Claude:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key-here
# Optional overrides
# LLM_MODEL=claude-sonnet-4-6
# IT_DEALS_DB_PATH=it_deals.db
